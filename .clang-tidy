---
# clang-tidy baseline for this repo (see AGENTS.md -> Verification -> clang-tidy).
#
# The gate is the bug class: whatever WarningsAsErrors names fails the run.
# Categories below that name deliberate project conventions are silenced, not
# fixed per-file:
#   -portability-avoid-pragma-once                 # #pragma once everywhere
#   -readability-identifier-length                 # short loop/iterator names
#   -readability-function-cognitive-complexity     # informational only
#   -misc-no-recursion                             # parser is recursive
#   -misc-non-private-member-variables-in-classes  # POD data structs
#   -misc-include-cleaner                          # headers are self-contained
#   -readability-trailing-comma                    # clang-format owns layout
#   -bugprone-easily-swappable-parameters          # call sites self-explain
#   -clang-analyzer-optin.performance.Padding      # struct-packing micro-opt
#   -performance-enum-size                         # enums not layout-critical
# If a real finding appears in an enabled category, fix it there; do not add a
# whole new suppression to this list without agreement.

Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  performance-*,
  portability-*,
  readability-*,
  misc-*,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -readability-trailing-comma,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-optin.performance.Padding,
  -performance-enum-size,

WarningsAsErrors: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  performance-*,

# Only our headers emit diagnostics; ours live directly under src/, unlike
# third-party (LspCpp/rapidjson) which sits deeper or under include/.
HeaderFilterRegex: 'src/[^/]*\.h$'

# readability-magic-numbers stays enabled (see TIDY.md): the values below are
# the idioms it may not flag — small counts, the decimal base, and the
# nanosecond/microsecond/millisecond unit ratios of the timing code. Powers
# of two (buffer sizes, bit widths) are likewise idiomatic. Anything else
# still reports, and a value with a meaning of its own gets a named constant,
# not a place on this list.
CheckOptions:
  - key: readability-magic-numbers.IgnoredIntegerValues
    value: '0;1;2;3;4;5;6;10;16;32;64'
  - key: readability-magic-numbers.IgnorePowerOfTwoIntegerValues
    value: true
