" Operators, longest first so multi-char operators win. `\V` makes
" the pattern very nomagic, so only `\` and `/` need escaping.
syn match   fbOperator /\V~/
syn match   fbOperator /\V|/
syn match   fbOperator /\V^/
syn match   fbOperator /\V\\/
syn match   fbOperator /\V@/
