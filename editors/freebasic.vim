" Vim syntax file for FreeBASIC.
" Generated by tools/gen_grammar from src/language.cpp; do not edit by hand.
" Install: ~/.vim/syntax/freebasic.vim, or a Neovim runtime path. See editors/README.md.

if exists("b:current_syntax")
  finish
endif
let b:current_syntax = "freebasic"

syn case ignore

" Comments. Vim regions nest only when the contained region is
" listed in `contains`, so /'...'/ nesting is approximated.
syn region  fbBlockComment start=+/\'+ end=+'/+ contains=fbBlockComment
syn match   fbComment /'.*$/ contains=fbBlockComment
syn match   fbRemComment /\<REM\>.*$/ contains=fbTodo
syn keyword fbTodo TODO FIXME XXX contained

" Strings; a doubled quote is an escaped quote.
syn region  fbString start=/[!$]\?"/ end=/"/ skip=/""/

" Numbers (radix, decimal, leading-dot) with an optional suffix.
syn match   fbNumber /&[HhOoBb][0-9A-Fa-f]\+[%&!#]\?/
syn match   fbNumber /\<\d\+\(\.\d\+\)\?\([eE][+-]\?\d\+\)\?[%&!#]\?/
syn match   fbNumber /\.\d\+\([eE][+-]\?\d\+\)\?[%&!#]\?/

" Preprocessor / metacommand lines.
syn match   fbPreProc /^\s*#.*$/

" Keywords (generated from src/language.cpp).
syn keyword fbKeyword abs abstract access acos alias allocate and andalso any append as asc asin asm assert assertwarn atan2 atn base beep bin binary bit bitreset bitset bload boolean bsave byref byte byval call callocate case cast cbool cbyte cdbl cdecl chain chdir chr cint circle class clear clng clngint close cls color command common condbroadcast condcreate conddestroy condsignal condwait const constructor continue cos cptr cshort csign csng csrlin cubyte cuint culng culngint cunsg curdir cushort cvd cvi cvl cvlongint cvs cvshort data date deallocate declare defbyte defdbl defined defint deflng deflongint defshort defsng defstr defubyte defuint defulongint defushort delete destructor dim dir do double draw dylibfree dylibload dylibsymbol else elseif encoding end endif enum environ eof eqv erase erfn erl ermn err error exec exepath exit exp explicit export extends extern false field fix flip for frac fre freefile function get getjoystick getkey getmouse gosub goto hex hibyte hiword if iif
